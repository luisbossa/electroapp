<!-- MODAL: FICHA TÉCNICA DE REPUESTO / BODEGA -->
<div
  id="modal-bodega"
  class="fixed inset-0 bg-slate-900/50 backdrop-blur-sm flex items-center justify-center hidden z-50 p-4 overflow-y-auto"
>
  <div
    class="bg-white rounded-xl shadow-2xl w-full max-w-3xl max-h-[90vh] flex flex-col border border-slate-200 overflow-hidden my-auto"
  >
    <div
      class="px-6 py-4 border-b border-slate-100 flex items-center justify-between bg-gradient-to-r from-emerald-900 via-emerald-800 to-slate-900 text-white shrink-0 shadow-sm"
    >
      <div class="flex items-center gap-3">
        <div
          class="p-2 bg-emerald-600 rounded-xl text-white shadow-lg ring-2 ring-emerald-400/40"
        >
          <i data-lucide="package" class="w-6 h-6"></i>
        </div>
        <div>
          <h3
            id="modal-bodega-title"
            class="font-extrabold text-lg tracking-tight text-white"
          >
            Ficha Técnica de Repuesto
          </h3>
          <p class="text-xs text-emerald-200 mt-0.5">
            Control de existencias y compatibilidad
          </p>
        </div>
      </div>
      <button
        onclick="closeModal('modal-bodega')"
        class="p-1.5 text-slate-300 hover:text-white rounded-lg hover:bg-white/10 transition"
      >
        <i data-lucide="x" class="w-6 h-6"></i>
      </button>
    </div>

    <form
      onsubmit="saveRepuesto(event)"
      class="p-6 space-y-6 overflow-y-auto flex-1 bg-slate-50/40"
    >
      <input type="hidden" id="rep-id" />
      <div
        class="bg-white p-5 rounded-2xl border border-slate-200 shadow-sm space-y-4"
      >
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          <div>
            <label class="block text-xs font-semibold text-slate-600 mb-1"
              >Foto Repuesto</label
            >
            <div
              id="repImgPreview"
              class="w-full h-40 border-2 border-dashed border-slate-300 rounded-lg flex items-center justify-center text-slate-400 text-xs bg-slate-50 bg-cover bg-center shadow-inner"
            >
              Vista Previa
            </div>
            <input
              type="file"
              id="rep-img"
              accept="image/*"
              class="mt-2 text-xs w-full text-slate-500"
              onchange="previewFile('rep-img', 'repImgPreview', setRepImg)"
            />
          </div>
          <div class="md:col-span-2 grid grid-cols-1 md:grid-cols-2 gap-4">
            <div class="md:col-span-2">
              <label class="block text-xs font-semibold text-slate-600 mb-1"
                >P/N (Nº Parte)*</label
              >
              <input
                type="text"
                id="rep-parte"
                required
                placeholder="PN-SPO2-01"
                class="w-full px-3 py-2 border border-slate-200 rounded-lg text-sm font-bold"
              />
            </div>
            <div class="md:col-span-2">
              <label class="block text-xs font-semibold text-slate-600 mb-1"
                >Descripción del Repuesto*</label
              >
              <input
                type="text"
                id="rep-nombre"
                required
                placeholder="Sensor SpO2 Adulto"
                class="w-full px-3 py-2 border border-slate-200 rounded-lg text-sm font-semibold"
              />
            </div>
            <div>
              <label class="block text-xs font-semibold text-slate-600 mb-1"
                >Categoría*</label
              >
              <select
                id="rep-categoria"
                class="w-full px-3 py-2 border border-slate-200 rounded-lg text-sm font-medium"
              >
                <option value="Sensores y Cables">Sensores y Cables</option>
                <option value="Filtros y Baterías">
                  Filtros y Baterías
                </option>
                <option value="Mangueras y Válvulas">
                  Mangueras y Válvulas
                </option>
                <option value="Tarjetas Electrónicas">
                  Tarjetas Electrónicas
                </option>
                <option value="Consumibles Varios">
                  Consumibles Varios
                </option>
              </select>
            </div>
            <div>
              <label class="block text-xs font-semibold text-slate-600 mb-1"
                >Fabricante</label
              >
              <input
                type="text"
                id="rep-marca"
                placeholder="Mindray, Dräger..."
                class="w-full px-3 py-2 border border-slate-200 rounded-lg text-sm"
              />
            </div>
          </div>
        </div>
      </div>

      <div
        class="bg-white p-5 rounded-2xl border border-slate-200 shadow-sm space-y-4"
      >
        <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
          <div>
            <label class="block text-xs font-semibold text-slate-600 mb-1"
              >Código SAP</label
            >
            <input
              type="text"
              id="rep-sap"
              placeholder="SAP-800101"
              class="w-full px-3 py-2 border border-slate-200 rounded-lg text-sm font-mono"
            />
          </div>
          <div>
            <label class="block text-xs font-semibold text-slate-600 mb-1"
              >Código SICOP</label
            >
            <input
              type="text"
              id="rep-sicop"
              placeholder="SICOP-REP-01"
              class="w-full px-3 py-2 border border-slate-200 rounded-lg text-sm font-mono"
            />
          </div>
          <div>
            <label class="block text-xs font-semibold text-slate-600 mb-1"
              >Estante / Ubicación*</label
            >
            <input
              type="text"
              id="rep-estante"
              placeholder="Estante A-01"
              class="w-full px-3 py-2 border border-slate-200 rounded-lg text-sm"
            />
          </div>
          <div class="hidden" aria-hidden="true">
            <select id="rep-proveedor-select"></select
            ><input type="hidden" id="rep-proveedor" value="" />
          </div>
        </div>
      </div>

      <div
        class="bg-white p-5 rounded-2xl border border-slate-200 shadow-sm space-y-4"
      >
        <div class="flex items-center justify-between">
          <h4 class="text-xs font-extrabold text-slate-900 uppercase">
            Modelos Compatibles
          </h4>
          <button
            type="button"
            onclick="addChipItem('Universal / Multimarca')"
            class="px-3 py-1 bg-emerald-100 text-emerald-800 rounded-lg text-xs font-bold"
          >
            + Universal
          </button>
        </div>
        <div
          class="bg-slate-50 p-4 rounded-xl border border-slate-200 space-y-3"
        >
          <div class="flex gap-2">
            <input
              type="text"
              id="chip-search-input"
              oninput="filterChipDropdown(this.value)"
              placeholder="Buscar modelo..."
              class="w-full px-3 py-1.5 text-xs rounded-lg border border-slate-200 bg-white"
            />
            <select
              id="chip-quick-select"
              onchange="
                if (this.value) {
                  addChipItem(this.value);
                  this.value = '';
                }
              "
              class="w-1/2 px-2.5 py-1.5 text-xs rounded-lg border border-slate-200 bg-white"
            ></select>
          </div>
          <div
            id="selected-chips-container"
            class="flex flex-wrap gap-1.5 min-h-[36px] p-2 bg-white rounded-xl border border-slate-200"
          ></div>
        </div>
      </div>

      <div
        class="bg-white p-5 rounded-2xl border border-slate-200 shadow-sm space-y-4"
      >
        <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
          <div>
            <label class="block text-xs font-semibold text-slate-600 mb-1"
              >Stock Actual*</label
            >
            <input
              type="number"
              id="rep-stock"
              readonly
              tabindex="-1"
              value="0"
              class="w-full px-3 py-2 border border-slate-300 rounded-lg text-sm font-bold bg-slate-100 text-slate-700 cursor-not-allowed"
            />
            <p class="text-[10px] text-slate-500 mt-1">
              El stock solo cambia mediante ingresos o salidas de bodega.
            </p>
            <button
              type="button"
              id="rep-ingreso-btn"
              onclick="openIngresoBodegaModal()"
              class="hidden mt-2 w-full px-3 py-2 bg-blue-50 text-blue-700 border border-blue-200 rounded-lg text-xs font-bold hover:bg-blue-100 transition"
            >
              <i data-lucide="package-plus" class="w-4 h-4 inline mr-1"></i>
              Registrar ingreso
            </button>
          </div>
          <div>
            <label class="block text-xs font-semibold text-slate-600 mb-1"
              >Stock Mínimo*</label
            >
            <input
              type="number"
              id="rep-min"
              required
              min="0"
              value="2"
              class="w-full px-3 py-2 border border-slate-200 rounded-lg text-sm font-bold text-red-600"
            />
          </div>
          <div class="hidden" aria-hidden="true">
            <select id="rep-moneda">
              <option value="$">$ USD</option>
              <option value="₡">₡ CRC</option></select
            ><input type="hidden" id="rep-costo-monto" value="" />
          </div>
          <div class="md:col-span-3">
            <label class="block text-xs font-semibold text-slate-600 mb-1"
              >Observaciones</label
            >
            <textarea
              id="rep-observaciones"
              rows="2"
              placeholder="Instrucciones..."
              class="w-full px-3 py-2 border border-slate-200 rounded-lg text-sm"
            ></textarea>
          </div>
        </div>
      </div>

      <div
        class="pt-4 flex justify-end gap-3 border-t border-slate-100 shrink-0"
      >
        <button
          type="button"
          onclick="closeModal('modal-bodega')"
          class="px-4 py-2 border border-slate-200 rounded-lg text-sm font-medium text-slate-600"
        >
          Cancelar
        </button>
        <button
          type="submit"
          class="px-5 py-2 bg-emerald-600 text-white rounded-lg text-sm font-medium hover:bg-emerald-700 shadow-sm"
        >
          Guardar Ficha Técnica
        </button>
      </div>
    </form>
  </div>
</div>
