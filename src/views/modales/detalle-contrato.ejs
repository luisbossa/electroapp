<!-- MODAL: DETALLE DEL CONTRATO DERIVADO -->
<div
  id="modal-detalle-contrato"
  class="fixed inset-0 bg-slate-900/65 backdrop-blur-sm flex items-center justify-center hidden z-[60] p-4 overflow-y-auto"
>
  <div
    class="bg-white rounded-2xl shadow-2xl w-full max-w-5xl max-h-[92vh] flex flex-col border border-slate-200 overflow-hidden my-auto"
  >
    <div
      class="px-6 py-5 bg-gradient-to-r from-blue-950 via-blue-900 to-slate-900 text-white flex items-start justify-between gap-4 shrink-0"
    >
      <div class="min-w-0">
        <p
          id="detalle-contrato-procedimiento"
          class="text-[11px] font-bold uppercase tracking-wider text-blue-200 mb-1"
        >
          Procedimiento
        </p>
        <h3
          id="detalle-contrato-numero"
          class="font-extrabold text-xl font-mono truncate"
        >
          Detalle del contrato
        </h3>
        <p
          id="detalle-contrato-nombre"
          class="text-sm text-blue-100 mt-1"
        ></p>
      </div>
      <button
        onclick="closeModal('modal-detalle-contrato')"
        class="text-blue-200 hover:text-white transition shrink-0"
        aria-label="Cerrar detalle"
      >
        <i data-lucide="x" class="w-6 h-6"></i>
      </button>
    </div>
    <div
      id="detalle-contrato-contenido"
      class="p-6 overflow-y-auto flex-1 bg-slate-50"
    ></div>
    <div
      class="px-6 py-4 bg-white border-t border-slate-200 flex flex-wrap justify-end gap-2 shrink-0"
    >
      <button
        id="detalle-contrato-equipos-btn"
        class="px-4 py-2 bg-blue-50 hover:bg-blue-100 text-blue-700 rounded-lg text-xs font-bold flex items-center gap-2"
      >
        <i data-lucide="stethoscope" class="w-4 h-4"></i> Ver equipos
        amparados
      </button>
      <button
        id="detalle-contrato-editar-btn"
        class="px-4 py-2 bg-emerald-600 hover:bg-emerald-700 text-white rounded-lg text-xs font-bold flex items-center gap-2"
      >
        <i data-lucide="pen-line" class="w-4 h-4"></i> Editar contrato
      </button>
      <button
        onclick="closeModal('modal-detalle-contrato')"
        class="px-4 py-2 bg-slate-200 hover:bg-slate-300 text-slate-700 rounded-lg text-xs font-semibold"
      >
        Cerrar
      </button>
    </div>
  </div>
</div>
