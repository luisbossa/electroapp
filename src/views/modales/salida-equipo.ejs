<!-- MODAL: REGISTRAR SALIDA DE EQUIPO -->
<div
  id="modal-salida-equipo"
  class="fixed inset-0 bg-slate-900/50 backdrop-blur-sm flex items-center justify-center hidden z-50 p-4"
>
  <div
    class="bg-white rounded-xl shadow-2xl w-full max-w-2xl border border-slate-200 overflow-hidden my-auto max-h-[90vh] flex flex-col"
  >
    <div
      class="px-6 py-4 border-b border-slate-100 flex items-center justify-between bg-blue-50 shrink-0"
    >
      <h3
        id="modal-salida-equipo-title"
        class="font-bold text-blue-900 text-lg"
      >
        Registrar Salida de Equipo Médico
      </h3>
      <button
        onclick="closeModal('modal-salida-equipo')"
        class="text-slate-400 hover:text-slate-600"
      >
        <i data-lucide="x" class="w-5 h-5"></i>
      </button>
    </div>
    <form
      onsubmit="saveSalidaEquipo(event)"
      class="p-6 space-y-4 overflow-y-auto flex-1"
    >
      <input type="hidden" id="seq-id" />
      <div
        class="bg-blue-50/70 p-3.5 rounded-xl border border-blue-200 space-y-2"
      >
        <label
          class="block text-xs font-bold text-blue-900 flex items-center gap-1.5"
          ><i data-lucide="search" class="w-3.5 h-3.5 text-blue-600"></i>
          Buscar por Número de Activo / Serie:</label
        >
        <div class="flex gap-2">
          <input
            type="text"
            id="seq-search-activo"
            data-smart-search="equipo"
            oninput="filterSeqEquipoOptions(this.value)"
            onchange="onSeqEquipoSearch(this.value)"
            onkeydown="handleSearchActivoKey(event)"
            autocomplete="off"
            class="smart-search-input w-full px-3 py-2 border border-blue-300 rounded-lg text-xs bg-white"
          /><datalist id="seq-equipo-list"></datalist>
          <button
            type="button"
            onclick="autoSelectFirstMatchedEquipo()"
            class="px-3 py-2 bg-blue-600 hover:bg-blue-700 text-white rounded-lg text-xs font-semibold"
          >
            Autocompletar
          </button>
        </div>
      </div>
      <input type="hidden" id="seq-equipo" />
      <div
        id="seq-equipo-preview"
        class="p-3 bg-slate-50 border border-slate-200 rounded-lg text-xs flex items-center justify-between"
      >
        <div>
          <p id="seq-prev-nombre" class="font-bold text-slate-800">
            Selecciona un equipo
          </p>
          <p id="seq-prev-detalles" class="text-slate-500">Activo: -</p>
        </div>
        <span
          id="seq-prev-estado"
          class="px-2 py-0.5 rounded-full text-[10px] font-bold bg-slate-200 text-slate-700"
          >Estado</span
        >
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <div>
          <label class="block text-xs font-semibold text-slate-600 mb-1"
            >Persona que retira*</label
          ><input
            type="text"
            id="seq-retira"
            required
            class="w-full px-3 py-2 border border-slate-200 rounded-lg text-sm"
          />
        </div>
        <div>
          <label class="block text-xs font-semibold text-slate-600 mb-1"
            >Persona que autoriza*</label
          ><input
            type="text"
            id="seq-autoriza"
            required
            class="w-full px-3 py-2 border border-slate-200 rounded-lg text-sm"
          />
        </div>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <div>
          <label class="block text-xs font-semibold text-slate-600 mb-1"
            >Proveedor / Destino*</label
          >
          <select
            id="seq-proveedor-select"
            onchange="syncSeqProveedorSelect(this)"
            class="w-full px-3 py-2 border border-slate-200 rounded-lg text-sm"
          ></select>
          <input
            type="text"
            id="seq-proveedor"
            required
            class="w-full px-3 py-2 border border-slate-200 rounded-lg text-sm mt-1"
          />
        </div>
        <div>
          <label class="block text-xs font-semibold text-slate-600 mb-1"
            >Motivo*</label
          >
          <select
            id="seq-motivo"
            required
            class="w-full px-3 py-2 border border-slate-200 rounded-lg text-sm"
          >
            <option value="Reparación">Reparación</option>
            <option value="Mantenimiento externo">
              Mantenimiento externo
            </option>
            <option value="Calibración">Calibración</option>
            <option value="Garantía">Garantía</option>
          </select>
        </div>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <div>
          <label class="block text-xs font-semibold text-slate-600 mb-1"
            >Fecha y hora de salida*</label
          ><input
            type="datetime-local"
            id="seq-fecha-salida"
            required
            class="w-full px-3 py-2 border border-slate-200 rounded-lg text-sm"
          />
        </div>
        <div>
          <label class="block text-xs font-semibold text-slate-600 mb-1"
            >Fecha prevista devolución*</label
          ><input
            type="date"
            id="seq-fecha-prevista"
            required
            class="w-full px-3 py-2 border border-slate-200 rounded-lg text-sm"
          />
        </div>
      </div>
      <div>
        <label class="block text-xs font-semibold text-slate-600 mb-1"
          >Comentarios</label
        >
        <textarea
          id="seq-comentarios"
          rows="2"
          class="w-full px-3 py-2 border border-slate-200 rounded-lg text-sm"
        ></textarea>
      </div>
      <div
        class="pt-4 flex justify-end gap-3 border-t border-slate-100 shrink-0"
      >
        <button
          type="button"
          onclick="closeModal('modal-salida-equipo')"
          class="px-4 py-2 text-slate-600 hover:bg-slate-100 rounded-lg text-sm font-medium"
        >
          Cancelar
        </button>
        <button
          type="submit"
          class="px-5 py-2 bg-blue-600 hover:bg-blue-700 text-white rounded-lg text-sm font-medium shadow-sm"
        >
          Registrar Salida
        </button>
      </div>
    </form>
  </div>
</div>
