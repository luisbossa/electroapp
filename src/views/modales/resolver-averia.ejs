<!-- MODAL: RESOLVER AVERÍA (CON FECHA, ATENCIÓN Y REPUESTOS DE BODEGA) -->
<div
  id="modal-resolver-averia"
  class="fixed inset-0 bg-slate-900/50 backdrop-blur-sm flex items-center justify-center hidden z-50 p-4"
>
  <div
    class="bg-white rounded-xl shadow-2xl w-full max-w-lg border border-slate-200 overflow-hidden my-auto max-h-[90vh] flex flex-col"
  >
    <div
      class="px-6 py-4 border-b border-slate-100 flex items-center justify-between bg-emerald-50 shrink-0"
    >
      <div class="flex items-center gap-2">
        <span class="p-1.5 bg-emerald-600 rounded-lg text-white"
          ><i data-lucide="circle-check" class="w-5 h-5"></i
        ></span>
        <h3 class="font-bold text-emerald-950 text-lg">
          Cerrar y Resolver Avería
        </h3>
      </div>
      <button
        onclick="closeModal('modal-resolver-averia')"
        class="text-slate-400 hover:text-slate-600"
      >
        <i data-lucide="x" class="w-5 h-5"></i>
      </button>
    </div>

    <form
      onsubmit="saveResolverAveria(event)"
      class="p-6 space-y-4 overflow-y-auto flex-1"
    >
      <input type="hidden" id="res-av-id" />

      <div>
        <label class="block text-xs font-semibold text-slate-600 mb-1"
          >Fecha y Hora de Atención / Solución*</label
        >
        <input
          type="datetime-local"
          id="res-av-fecha"
          required
          class="w-full px-3 py-2 border border-slate-200 rounded-lg text-sm font-semibold"
        />
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <div>
          <label class="block text-xs font-semibold text-slate-600 mb-1"
            >Atendido Por*</label
          >
          <select
            id="res-av-tipo-atencion"
            onchange="toggleProveedorResolverField()"
            required
            class="w-full px-3 py-2 border border-slate-200 rounded-lg text-sm font-medium"
          >
            <option value="Funcionario CCSS">
              Funcionario CCSS (Ingeniería Biomédica)
            </option>
            <option value="Proveedor Externo">
              Proveedor Externo / Casa Comercial
            </option>
          </select>
        </div>
        <div>
          <label class="block text-xs font-semibold text-slate-600 mb-1"
            >Nombre del Técnico / Especialista*</label
          >
          <input
            type="text"
            id="res-av-tecnico"
            required
            placeholder="Ing. Ramírez"
            class="w-full px-3 py-2 border border-slate-200 rounded-lg text-sm"
          />
        </div>
      </div>

      <div id="wrapper-res-proveedor" class="hidden">
        <label class="block text-xs font-semibold text-slate-600 mb-1"
          >Casa Comercial / Proveedor*</label
        >
        <input
          type="text"
          id="res-av-proveedor"
          placeholder="Nombre de la empresa proveedora..."
          class="w-full px-3 py-2 border border-slate-200 rounded-lg text-sm"
        />
      </div>

      <!-- SECCIÓN DE REPUESTOS DE BODEGA -->
      <div
        class="bg-emerald-50/70 p-4 rounded-xl border border-emerald-200 space-y-3"
      >
        <div class="flex items-center justify-between">
          <label
            class="text-xs font-bold text-emerald-950 flex items-center gap-1.5"
          >
            <i data-lucide="package" class="w-4 h-4 text-emerald-600"></i>
            ¿Se utilizó algún repuesto de bodega?
          </label>
          <input
            type="checkbox"
            id="res-av-uso-repuesto"
            onchange="toggleRepuestoResolverField()"
            class="w-4 h-4 text-emerald-600 rounded"
          />
        </div>

        <div
          id="wrapper-res-repuesto"
          class="hidden space-y-3 pt-2 border-t border-emerald-200/80"
        >
          <div>
            <label class="block text-[11px] font-bold text-slate-600 mb-1"
              >Seleccionar Repuesto / Accesorio:</label
            >
            <input
              id="res-av-repuesto-select"
              data-smart-search="repuesto"
              autocomplete="off"
              placeholder="Digite la descripción del repuesto"
              class="smart-search-input w-full px-3 py-2 border border-slate-200 rounded-lg text-xs bg-white"
            /><datalist id="res-av-repuesto-list"></datalist>
          </div>
          <div>
            <label class="block text-[11px] font-bold text-slate-600 mb-1"
              >Cantidad Utilizada:</label
            >
            <input
              type="number"
              id="res-av-repuesto-cant"
              min="1"
              value="1"
              class="w-full px-3 py-2 border border-slate-200 rounded-lg text-xs font-bold bg-white"
            />
          </div>
          <p class="text-[10px] text-emerald-800 italic">
            Se descontará automáticamente del stock de bodega y se
            registrará la salida para este equipo.
          </p>
        </div>
      </div>

      <div>
        <label class="block text-xs font-semibold text-slate-600 mb-1"
          >Acciones Realizadas / Diagnóstico Final*</label
        >
        <textarea
          id="res-av-acciones"
          required
          rows="3"
          placeholder="Se reemplazó sensor, se realizaron pruebas de funcionamiento y calibración satisfactorias..."
          class="w-full px-3 py-2 border border-slate-200 rounded-lg text-sm"
        ></textarea>
      </div>

      <div
        class="pt-4 flex justify-end gap-3 border-t border-slate-100 shrink-0"
      >
        <button
          type="button"
          onclick="closeModal('modal-resolver-averia')"
          class="px-4 py-2 text-slate-600 hover:bg-slate-100 rounded-lg text-sm font-medium"
        >
          Cancelar
        </button>
        <button
          type="submit"
          class="px-5 py-2 bg-emerald-600 hover:bg-emerald-700 text-white rounded-lg text-sm font-medium shadow-sm flex items-center gap-2"
        >
          <i data-lucide="check" class="w-4 h-4"></i> Confirmar y Resolver
        </button>
      </div>
    </form>
  </div>
</div>
