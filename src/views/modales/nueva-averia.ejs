<!-- MODAL: REGISTRAR / REPORTAR NUEVA AVERÍA -->
<div
  id="modal-averia"
  class="fixed inset-0 bg-slate-900/50 backdrop-blur-sm flex items-center justify-center hidden z-50 p-4"
>
  <div
    class="bg-white rounded-xl shadow-2xl w-full max-w-2xl border border-slate-200 overflow-hidden my-auto max-h-[90vh] flex flex-col"
  >
    <div
      class="px-6 py-4 border-b border-slate-100 flex items-center justify-between bg-red-50 shrink-0"
    >
      <div class="flex items-center gap-2.5">
        <div class="p-2 bg-red-600 text-white rounded-lg shadow-sm">
          <i data-lucide="octagon-alert" class="w-5 h-5"></i>
        </div>
        <div>
          <h3 class="font-bold text-red-950 text-lg">
            Reporte de Avería / Mto Correctivo
          </h3>
          <p class="text-xs text-red-700">
            Registrar falla operativa de equipo biomédico
          </p>
        </div>
      </div>
      <button
        onclick="closeModal('modal-averia')"
        class="text-slate-400 hover:text-slate-600"
      >
        <i data-lucide="x" class="w-5 h-5"></i>
      </button>
    </div>

    <form
      onsubmit="saveAveria(event)"
      class="p-6 space-y-4 overflow-y-auto flex-1"
    >
      <input type="hidden" id="av-id" />

      <!-- BUSCADOR RÁPIDO POR NÚMERO DE ACTIVO -->
      <div
        class="bg-red-50/70 p-3.5 rounded-xl border border-red-200 space-y-2"
      >
        <label
          class="block text-xs font-bold text-red-900 flex items-center gap-1.5"
        >
          <i data-lucide="search" class="w-3.5 h-3.5 text-red-600"></i>
          Buscar y Autocompletar por Número de Activo / Serie / Nombre:
        </label>
        <div class="flex gap-2">
          <input
            type="text"
            id="av-search-activo"
            data-smart-search="equipo"
            oninput="filterAvEquipoOptions(this.value)"
            onchange="onAvEquipoSearch(this.value)"
            onkeydown="handleSearchActivoAvKey(event)"
            placeholder="Digita el N° de Activo (ej: EQ-2026-001)..."
            autocomplete="off"
            class="smart-search-input w-full px-3 py-2 border border-red-300 rounded-lg text-xs bg-white focus:outline-none focus:ring-2 focus:ring-red-500 font-medium"
          /><datalist id="av-equipo-list"></datalist>
          <button
            type="button"
            onclick="autoSelectFirstMatchedAvEquipo()"
            class="px-3 py-2 bg-red-600 hover:bg-red-700 text-white rounded-lg text-xs font-semibold whitespace-nowrap transition flex items-center gap-1"
          >
            <i data-lucide="check" class="w-3.5 h-3.5"></i> Autocompletar
          </button>
        </div>
        <p class="text-[11px] text-red-700 italic">
          Al digitar el número de activo o presionar Enter, se seleccionará
          automáticamente el equipo.
        </p>
      </div>

      <input type="hidden" id="av-equipo" />

      <!-- PREVIEW DEL EQUIPO SELECCIONADO -->
      <div
        id="av-equipo-preview"
        class="p-3 bg-slate-50 border border-slate-200 rounded-lg text-xs flex items-center justify-between"
      >
        <div>
          <p id="av-prev-nombre" class="font-bold text-slate-800">
            Selecciona un equipo
          </p>
          <p id="av-prev-detalles" class="text-slate-500">
            Activo: - | Serie: - | Ubicación: -
          </p>
        </div>
        <span
          id="av-prev-estado"
          class="px-2 py-0.5 rounded-full text-[10px] font-bold bg-slate-200 text-slate-700"
          >Estado</span
        >
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <div>
          <label class="block text-xs font-semibold text-slate-600 mb-1"
            >Fecha y Hora de la Avería / Reporte*</label
          >
          <input
            type="datetime-local"
            id="av-fecha-hora"
            required
            class="w-full px-3 py-2 border border-slate-200 rounded-lg text-sm"
          />
        </div>
        <div>
          <label class="block text-xs font-semibold text-slate-600 mb-1"
            >Funcionario que Reporta*</label
          >
          <input
            type="text"
            id="av-reporta"
            required
            placeholder="Nombre del médico / enfermero / técnico"
            class="w-full px-3 py-2 border border-slate-200 rounded-lg text-sm"
          />
        </div>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <div>
          <label class="block text-xs font-semibold text-slate-600 mb-1"
            >Nivel de Prioridad*</label
          >
          <select
            id="av-prioridad"
            required
            class="w-full px-3 py-2 border border-slate-200 rounded-lg text-sm font-semibold"
          >
            <option value="Baja">
              Baja (Detalle menor / equipo usable)
            </option>
            <option value="Media">Media (Falla parcial)</option>
            <option value="Urgente">Urgente (Afectación crítica)</option>
          </select>
        </div>
        <div>
          <label class="block text-xs font-semibold text-slate-600 mb-1"
            >¿Equipo queda Fuera de Servicio?*</label
          >
          <select
            id="av-fuera-servicio"
            required
            class="w-full px-3 py-2 border border-slate-200 rounded-lg text-sm font-bold text-red-600 bg-red-50/50"
          >
            <option value="SI">SÍ - Inoperativo / No utilizar</option>
            <option value="NO">NO - Operativo con observación</option>
          </select>
        </div>
      </div>

      <div>
        <label class="block text-xs font-semibold text-slate-600 mb-1"
          >Descripción Detallada de la Falla*</label
        >
        <textarea
          id="av-descripcion"
          required
          rows="3"
          placeholder="Describe el síntoma, código de error o anomalía observada..."
          class="w-full px-3 py-2 border border-slate-200 rounded-lg text-sm"
        ></textarea>
      </div>

      <div>
        <label class="block text-xs font-semibold text-slate-600 mb-1"
          >Comentario Inicial de Avance (Opcional)</label
        >
        <input
          type="text"
          id="av-primer-comentario"
          placeholder="Ej: Se apaga equipo y se traslada a taller..."
          class="w-full px-3 py-2 border border-slate-200 rounded-lg text-sm"
        />
      </div>

      <div
        class="pt-4 flex justify-end gap-3 border-t border-slate-100 shrink-0"
      >
        <button
          type="button"
          onclick="closeModal('modal-averia')"
          class="px-4 py-2 text-slate-600 hover:bg-slate-100 rounded-lg text-sm font-medium"
        >
          Cancelar
        </button>
        <button
          type="submit"
          class="px-5 py-2 bg-red-600 hover:bg-red-700 text-white rounded-lg text-sm font-medium shadow-sm flex items-center gap-2"
        >
          <i data-lucide="save" class="w-4 h-4"></i> Registrar Reporte
        </button>
      </div>
    </form>
  </div>
</div>
