<!-- MODAL: INGRESO CONTROLADO DE REPUESTOS -->
<div
  id="modal-ingreso-bodega"
  class="fixed inset-0 bg-slate-900/50 backdrop-blur-sm flex items-center justify-center hidden z-[60] p-4 overflow-y-auto"
>
  <div
    class="bg-white rounded-2xl shadow-2xl w-full max-w-xl border border-slate-200 overflow-hidden my-auto"
  >
    <div
      class="px-6 py-4 bg-gradient-to-r from-blue-800 to-slate-900 text-white flex items-center justify-between"
    >
      <div>
        <h3 class="font-extrabold text-lg">Registrar ingreso a bodega</h3>
        <p class="text-xs text-blue-200">
          El movimiento aumentará el stock y quedará registrado.
        </p>
      </div>
      <button
        type="button"
        onclick="closeModal('modal-ingreso-bodega')"
        class="p-1.5 text-blue-100 hover:text-white"
      >
        <i data-lucide="x" class="w-5 h-5"></i>
      </button>
    </div>
    <form onsubmit="saveIngresoBodega(event)" class="p-6 space-y-4">
      <input type="hidden" id="ingreso-repuesto-id" />
      <div class="p-4 bg-blue-50 border border-blue-200 rounded-xl">
        <p class="text-[10px] font-bold text-blue-600 uppercase">
          Repuesto
        </p>
        <p
          id="ingreso-repuesto-nombre"
          class="font-bold text-slate-800 mt-1"
        ></p>
        <p
          id="ingreso-stock-actual"
          class="text-xs text-slate-500 mt-1"
        ></p>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <div>
          <label class="block text-xs font-bold text-slate-700 mb-1"
            >Cantidad que ingresa*</label
          ><input
            id="ingreso-cantidad"
            type="number"
            min="1"
            required
            class="w-full px-3 py-2 border border-slate-300 rounded-lg text-sm font-bold"
            placeholder="Ej. 10"
          />
        </div>
        <div>
          <label class="block text-xs font-bold text-slate-700 mb-1"
            >Fecha de ingreso*</label
          ><input
            id="ingreso-fecha"
            type="date"
            required
            class="w-full px-3 py-2 border border-slate-300 rounded-lg text-sm"
          />
        </div>
      </div>
      <div>
        <label class="block text-xs font-bold text-slate-700 mb-1"
          >Procedencia de los repuestos*</label
        ><input
          id="ingreso-origen"
          required
          class="w-full px-3 py-2 border border-slate-300 rounded-lg text-sm"
          placeholder="Proveedor, compra, traslado, donación, devolución..."
        />
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <div>
          <label class="block text-xs font-bold text-slate-700 mb-1"
            >Documento de respaldo</label
          ><input
            id="ingreso-documento"
            class="w-full px-3 py-2 border border-slate-300 rounded-lg text-sm"
            placeholder="Factura, orden, acta o traslado"
          />
        </div>
        <div>
          <label class="block text-xs font-bold text-slate-700 mb-1"
            >Responsable del ingreso*</label
          ><input
            id="ingreso-responsable"
            required
            class="w-full px-3 py-2 border border-slate-300 rounded-lg text-sm"
            placeholder="Nombre del funcionario"
          />
        </div>
      </div>
      <div>
        <label class="block text-xs font-bold text-slate-700 mb-1"
          >Observaciones</label
        ><textarea
          id="ingreso-observaciones"
          rows="2"
          class="w-full px-3 py-2 border border-slate-300 rounded-lg text-sm"
          placeholder="Detalle adicional del ingreso"
        ></textarea>
      </div>
      <div class="flex justify-end gap-2 pt-3 border-t border-slate-200">
        <button
          type="button"
          onclick="closeModal('modal-ingreso-bodega')"
          class="px-4 py-2 text-slate-600 hover:bg-slate-100 rounded-lg text-sm font-semibold"
        >
          Cancelar</button
        ><button
          type="submit"
          class="px-5 py-2 bg-blue-600 hover:bg-blue-700 text-white rounded-lg text-sm font-bold shadow-sm"
        >
          <i data-lucide="save" class="w-4 h-4 inline mr-1"></i> Guardar
          ingreso
        </button>
      </div>
    </form>
  </div>
</div>
