<!-- MODAL: REGISTRAR / EDITAR PROCEDIMIENTO -->
<div
  id="modal-procedimiento"
  class="fixed inset-0 bg-slate-900/50 backdrop-blur-sm flex items-center justify-center hidden z-50 p-4"
>
  <div
    class="bg-white rounded-xl shadow-2xl w-full max-w-xl border border-slate-200 overflow-hidden my-auto max-h-[90vh] flex flex-col"
  >
    <div
      class="px-6 py-4 border-b border-slate-100 flex items-center justify-between bg-blue-50 shrink-0"
    >
      <h3 id="modal-proc-title" class="font-bold text-blue-900 text-lg">
        Registrar Procedimiento Concursal
      </h3>
      <button
        onclick="closeModal('modal-procedimiento')"
        class="text-slate-400 hover:text-slate-600"
      >
        <i data-lucide="x" class="w-5 h-5"></i>
      </button>
    </div>
    <form
      onsubmit="saveProcedimiento(event)"
      class="p-6 space-y-4 overflow-y-auto flex-1"
    >
      <input type="hidden" id="proc-id" />
      <div>
        <label class="block text-xs font-semibold text-slate-600 mb-1"
          >Nº de Concurso / Procedimiento (Ej: Licitación Abreviada
          2026-LA-001)*</label
        >
        <input
          type="text"
          id="proc-numero"
          required
          placeholder="N° de Concurso o Procedimiento..."
          class="w-full px-3 py-2 border border-slate-200 rounded-lg text-sm font-bold text-blue-600"
        />
      </div>
      <div>
        <label class="block text-xs font-semibold text-slate-600 mb-1"
          >Objeto del Procedimiento / Descripción*</label
        >
        <textarea
          id="proc-descripcion"
          required
          rows="2"
          placeholder="Adquisición y mantenimiento de equipos..."
          class="w-full px-3 py-2 border border-slate-200 rounded-lg text-sm"
        ></textarea>
      </div>
      <div
        class="pt-4 flex justify-end gap-3 border-t border-slate-100 shrink-0"
      >
        <button
          type="button"
          onclick="closeModal('modal-procedimiento')"
          class="px-4 py-2 text-slate-600 hover:bg-slate-100 rounded-lg text-sm font-medium"
        >
          Cancelar
        </button>
        <button
          type="submit"
          class="px-5 py-2 bg-blue-600 hover:bg-blue-700 text-white rounded-lg text-sm font-medium shadow-sm"
        >
          Guardar Procedimiento
        </button>
      </div>
    </form>
  </div>
</div>
