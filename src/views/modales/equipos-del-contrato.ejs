<!-- MODAL: LISTADO DE EQUIPOS AMPARADOS A UN CONTRATO -->
<div
  id="modal-equipos-contrato"
  class="fixed inset-0 bg-slate-900/60 backdrop-blur-sm flex items-center justify-center hidden z-[70] p-4 overflow-y-auto"
>
  <div
    class="bg-white rounded-2xl shadow-2xl w-full max-w-3xl max-h-[90vh] flex flex-col border border-slate-200 overflow-hidden my-auto"
  >
    <div
      class="px-6 py-4 bg-gradient-to-r from-blue-900 to-slate-900 text-white flex items-center justify-between shrink-0 shadow-sm"
    >
      <div>
        <h3 id="modal-eq-cont-title" class="font-extrabold text-lg">
          Equipos Amparados al Contrato
        </h3>
        <p id="modal-eq-cont-subtitle" class="text-xs text-blue-200 mt-0.5">
          Listado de activos médicos vinculados
        </p>
      </div>
      <button
        onclick="closeModal('modal-equipos-contrato')"
        class="text-slate-300 hover:text-white transition"
      >
        <i data-lucide="x" class="w-6 h-6"></i>
      </button>
    </div>
    <div class="p-6 overflow-y-auto flex-1 bg-slate-50/50">
      <div
        class="bg-white rounded-xl border border-slate-200 shadow-sm overflow-hidden"
      >
        <div class="overflow-x-auto">
          <table class="w-full text-left text-sm">
            <thead
              class="bg-slate-50 text-slate-500 font-semibold border-b border-slate-200 text-xs"
            >
              <tr>
                <th class="p-3">Nº Activo / Serie</th>
                <th class="p-3">Equipo</th>
                <th class="p-3">Marca / Modelo</th>
                <th class="p-3">Sede / Ubicación</th>
                <th class="p-3">Estado</th>
              </tr>
            </thead>
            <tbody
              id="table-equipos-contrato"
              class="divide-y divide-slate-100 text-xs"
            ></tbody>
          </table>
        </div>
      </div>
    </div>
    <div
      class="p-4 bg-white border-t border-slate-200 flex justify-end shrink-0"
    >
      <button
        onclick="closeModal('modal-equipos-contrato')"
        class="px-4 py-2 bg-slate-200 hover:bg-slate-300 text-slate-700 rounded-lg text-xs font-semibold transition"
      >
        Cerrar
      </button>
    </div>
  </div>
</div>
