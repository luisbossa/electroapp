<!-- MODAL: EXPEDIENTE / HISTORIAL DE AVANCES DE AVERÍA -->
<div
  id="modal-historial-averia"
  class="fixed inset-0 bg-slate-900/60 backdrop-blur-sm flex items-center justify-center hidden z-50 p-4 overflow-y-auto"
>
  <div
    class="bg-white rounded-2xl shadow-2xl w-full max-w-3xl max-h-[92vh] flex flex-col border border-slate-200 overflow-hidden my-auto"
  >
    <div
      class="px-6 py-4 bg-gradient-to-r from-slate-900 to-red-950 text-white flex items-center justify-between shrink-0 shadow-sm"
    >
      <div>
        <div class="flex items-center gap-2">
          <span class="p-1.5 bg-red-600 rounded-lg text-white"
            ><i data-lucide="octagon-alert" class="w-5 h-5"></i
          ></span>
          <h3 id="hist-av-title" class="font-extrabold text-lg">
            Expediente de Avería #REP-101
          </h3>
        </div>
        <p id="hist-av-subtitle" class="text-xs text-red-200 mt-0.5">
          Seguimiento técnico, bitácora e indisponibilidad del equipo
        </p>
      </div>
      <button
        onclick="closeModal('modal-historial-averia')"
        class="text-slate-300 hover:text-white transition"
      >
        <i data-lucide="x" class="w-6 h-6"></i>
      </button>
    </div>

    <div class="p-6 overflow-y-auto space-y-6 flex-1 bg-slate-50/50">
      <div class="grid grid-cols-2 md:grid-cols-4 gap-3 text-center">
        <div
          class="bg-white p-3 rounded-xl border border-slate-200 shadow-sm"
        >
          <p class="text-[11px] font-semibold text-slate-400 uppercase">
            Estado
          </p>
          <p
            id="hist-av-badge-estado"
            class="mt-1 font-bold text-xs px-2.5 py-1 rounded-full inline-block bg-red-100 text-red-800"
          >
            -
          </p>
        </div>
        <div
          class="bg-white p-3 rounded-xl border border-slate-200 shadow-sm"
        >
          <p class="text-[11px] font-semibold text-slate-400 uppercase">
            Prioridad
          </p>
          <p
            id="hist-av-prioridad"
            class="mt-1 font-bold text-slate-800 text-xs"
          >
            -
          </p>
        </div>
        <div
          class="bg-white p-3 rounded-xl border border-slate-200 shadow-sm"
        >
          <p class="text-[11px] font-semibold text-slate-400 uppercase">
            Fuera de Servicio
          </p>
          <p id="hist-av-fs" class="mt-1 font-bold text-xs text-red-600">
            -
          </p>
        </div>
        <div
          class="bg-white p-3 rounded-xl border border-slate-200 shadow-sm"
        >
          <p class="text-[11px] font-semibold text-slate-400 uppercase">
            Tiempo Indisp.
          </p>
          <p
            id="hist-av-tiempo-indisp"
            class="mt-1 font-bold text-slate-900 text-xs font-mono"
          >
            -
          </p>
        </div>
      </div>

      <div
        class="bg-white p-5 rounded-xl border border-slate-200 shadow-sm space-y-4"
      >
        <div class="section-header-badge rose">
          <div class="p-1.5 bg-rose-600 text-white rounded-lg shadow-sm">
            <i data-lucide="info" class="w-4 h-4"></i>
          </div>
          <div>
            <h4
              class="text-xs sm:text-sm font-extrabold text-slate-900 uppercase tracking-wider"
            >
              Detalles del Reporte y Equipo
            </h4>
            <p class="text-[11px] text-slate-500 font-medium">
              Ubicación, funcionario y descripción técnica
            </p>
          </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-4 text-xs">
          <div>
            <p class="text-slate-400 font-medium">Equipo Médico:</p>
            <p
              id="hist-av-eq-nombre"
              class="font-bold text-slate-800 text-sm"
            >
              -
            </p>
          </div>
          <div>
            <p class="text-slate-400 font-medium">Activo / Serie:</p>
            <p id="hist-av-activo-serie" class="font-bold text-slate-800">
              -
            </p>
          </div>
          <div>
            <p class="text-slate-400 font-medium">Sede / Servicio:</p>
            <p id="hist-av-ubicacion" class="font-semibold text-slate-800">
              -
            </p>
          </div>
          <div>
            <p class="text-slate-400 font-medium">
              Fecha y Hora de Reporte:
            </p>
            <p
              id="hist-av-fecha"
              class="font-semibold text-slate-800 font-mono"
            >
              -
            </p>
          </div>
          <div>
            <p class="text-slate-400 font-medium">Reportado Por:</p>
            <p id="hist-av-reporta" class="font-semibold text-slate-800">
              -
            </p>
          </div>
          <div>
            <p class="text-slate-400 font-medium">Resolución / Atención:</p>
            <p
              id="hist-av-resolucion-info"
              class="font-semibold text-emerald-700"
            >
              Pendiente
            </p>
          </div>
          <div
            class="md:col-span-2 bg-slate-50 p-3 rounded-lg border border-slate-200"
          >
            <p class="text-slate-500 font-semibold mb-1">
              Descripción de la Avería:
            </p>
            <p
              id="hist-av-desc"
              class="text-slate-800 font-medium text-xs leading-relaxed"
            >
              -
            </p>
          </div>
        </div>
      </div>

      <div
        class="bg-white p-5 rounded-xl border border-slate-200 shadow-sm space-y-4"
      >
        <div
          class="flex items-center justify-between border-b border-slate-100 pb-2"
        >
          <h4
            class="text-xs font-bold text-red-600 uppercase tracking-wider flex items-center gap-2"
          >
            <i data-lucide="message-square" class="w-4 h-4"></i> Bitácora de
            Avances y Seguimiento
          </h4>
          <span
            id="hist-av-comentarios-count"
            class="text-[11px] text-slate-400 font-semibold"
            >0 notas</span
          >
        </div>

        <div
          class="no-imprimir bg-slate-50 p-3 rounded-xl border border-slate-200 space-y-2"
        >
          <label class="block text-xs font-semibold text-slate-700"
            >Agregar nuevo avance técnico:</label
          >
          <div class="flex gap-2">
            <input
              type="text"
              id="hist-av-nuevo-comentario"
              class="w-full px-3 py-2 border border-slate-200 rounded-lg text-xs bg-white focus:outline-none focus:ring-1 focus:ring-red-500"
            />
            <button
              onclick="addAvanceFromExpedienteAveria()"
              class="px-4 py-2 bg-red-600 hover:bg-red-700 text-white rounded-lg text-xs font-semibold whitespace-nowrap transition"
            >
              Agregar
            </button>
          </div>
        </div>

        <div
          id="hist-av-timeline-container"
          class="space-y-3 max-h-56 overflow-y-auto pr-1"
        ></div>
      </div>
    </div>

    <div
      class="no-imprimir p-4 bg-white border-t border-slate-200 flex justify-between items-center shrink-0"
    >
      <button
        onclick="imprimirVentana(this)"
        class="px-4 py-2 bg-slate-800 hover:bg-black text-white rounded-lg text-xs font-semibold flex items-center gap-2 transition"
      >
        <i data-lucide="printer" class="w-4 h-4"></i> Imprimir Expediente
      </button>
      <button
        onclick="closeModal('modal-historial-averia')"
        class="px-4 py-2 bg-slate-200 hover:bg-slate-300 text-slate-700 rounded-lg text-xs font-semibold transition"
      >
        Cerrar
      </button>
    </div>
  </div>
</div>
