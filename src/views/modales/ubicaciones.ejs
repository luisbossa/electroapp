<!-- MODAL: ADMINISTRACIÓN DE UBICACIONES -->
<div
  id="modal-ubicaciones"
  class="hidden fixed inset-0 z-[95] bg-slate-900/60 backdrop-blur-sm p-4 flex items-center justify-center"
>
  <div
    class="w-full max-w-2xl max-h-[88vh] bg-white rounded-2xl shadow-2xl overflow-hidden flex flex-col"
  >
    <div
      class="px-5 py-4 border-b border-slate-200 flex items-center justify-between bg-white"
    >
      <div>
        <h3
          class="text-lg font-extrabold text-slate-900 flex items-center gap-2"
        >
          <i data-lucide="map-pinned" class="w-5 h-5 text-blue-600"></i>
          Administrar ubicaciones
        </h3>
        <p class="text-xs text-slate-500 mt-1">
          Agrega, modifica o elimina las sedes y ubicaciones disponibles
          para los equipos.
        </p>
      </div>
      <button
        type="button"
        onclick="closeUbicacionesManager()"
        class="p-2 rounded-lg hover:bg-slate-100 text-slate-500"
      >
        <i data-lucide="x" class="w-5 h-5"></i>
      </button>
    </div>

    <div class="p-5 overflow-y-auto space-y-5">
      <div class="p-4 rounded-xl border border-blue-200 bg-blue-50/60">
        <label class="block text-xs font-bold text-slate-700 mb-2"
          >Nueva ubicación</label
        >
        <div class="flex flex-col sm:flex-row gap-2">
          <input
            id="nueva-ubicacion-input"
            type="text"
            maxlength="80"
            class="flex-1 px-3 py-2.5 rounded-lg border border-slate-300 bg-white text-sm"
            placeholder="Ej.: EBAIS San Pedro"
          />
          <button
            type="button"
            onclick="addUbicacionGestion()"
            class="px-4 py-2.5 rounded-lg bg-blue-600 hover:bg-blue-700 text-white text-sm font-bold flex items-center justify-center gap-2"
          >
            <i data-lucide="plus" class="w-4 h-4"></i> Agregar
          </button>
        </div>
      </div>

      <div>
        <div class="flex items-center justify-between mb-3">
          <h4 class="text-sm font-extrabold text-slate-800">
            Ubicaciones registradas
          </h4>
          <span
            id="ubicaciones-manager-count"
            class="text-xs font-bold text-blue-700 bg-blue-50 border border-blue-200 px-2.5 py-1 rounded-full"
            >0</span
          >
        </div>
        <div id="ubicaciones-manager-list" class="space-y-2"></div>
      </div>
    </div>

    <div
      class="px-5 py-4 border-t border-slate-200 bg-slate-50 flex justify-end"
    >
      <button
        type="button"
        onclick="closeUbicacionesManager()"
        class="px-4 py-2 rounded-lg border border-slate-300 bg-white hover:bg-slate-100 text-slate-700 text-sm font-bold"
      >
        Cerrar
      </button>
    </div>
  </div>
</div>
