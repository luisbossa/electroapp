<!-- MODAL: PLAN DE MANTENIMIENTO PREVENTIVO -->
<div
  id="modal-cronograma"
  class="fixed inset-0 bg-slate-900/60 backdrop-blur-sm flex items-start justify-center hidden z-50 p-4 overflow-y-auto"
>
  <div
    class="bg-white rounded-2xl shadow-2xl w-full max-w-5xl border border-slate-200 overflow-hidden my-4 max-h-[94vh] flex flex-col"
  >
    <div
      class="px-6 py-4 bg-gradient-to-r from-blue-900 to-slate-900 text-white flex items-center justify-between shrink-0 sticky top-0 z-10"
    >
      <div>
        <h3 id="cron-modal-title" class="font-extrabold text-lg">
          Nuevo Plan Preventivo
        </h3>
        <p class="text-xs text-blue-200">
          Contrato → equipos → frecuencia → visitas → seguimiento
        </p>
      </div>
      <button
        onclick="closeCronogramaModal()"
        class="text-slate-300 hover:text-white"
      >
        <i data-lucide="x" class="w-6 h-6"></i>
      </button>
    </div>
    <form
      onsubmit="saveCronograma(event)"
      class="p-6 space-y-6 overflow-y-auto"
    >
      <input type="hidden" id="cron-id" /><input
        type="hidden"
        id="cron-proc-id"
      /><input type="hidden" id="cron-contrato-id" />
      <div>
        <div class="section-header-badge">
          <i data-lucide="file-text" class="w-4 h-4 text-blue-600"></i>
          <div>
            <p class="text-xs font-bold text-slate-800">
              1. Contrato o servicio
            </p>
            <p class="text-[10px] text-slate-500">
              Busque y seleccione un contrato registrado. La información se
              completará automáticamente.
            </p>
          </div>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mt-4">
          <div>
            <label class="block text-xs font-semibold text-slate-600 mb-1"
              >Buscar contrato</label
            >
            <div class="relative">
              <i
                data-lucide="search"
                class="absolute left-3 top-2.5 w-4 h-4 text-slate-400"
              ></i
              ><input
                id="cron-contrato-search"
                oninput="buildCronContratoOptions()"
                autocomplete="off"
                class="w-full pl-9 pr-3 py-2 border border-slate-300 rounded-lg text-sm"
                placeholder="Número, nombre, proveedor o procedimiento..."
              />
            </div>
          </div>
          <div>
            <label class="block text-xs font-semibold text-slate-600 mb-1"
              >Seleccionar contrato*</label
            ><select
              id="cron-contrato-select"
              required
              onchange="selectCronContrato(this.value)"
              class="w-full px-3 py-2 border border-slate-300 rounded-lg text-sm bg-white"
            >
              <option value="">Seleccione un contrato...</option>
            </select>
          </div>
        </div>
        <div
          id="cron-contrato-info"
          class="hidden mt-4 bg-blue-50/60 border border-blue-200 rounded-xl overflow-hidden"
        >
          <div
            class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 text-sm"
          >
            <div class="p-3 border-b sm:border-r border-blue-100">
              <span
                class="block text-[10px] uppercase font-bold text-blue-500"
                >Contrato</span
              ><strong
                id="cron-info-numero"
                class="font-mono text-blue-950"
              ></strong>
            </div>
            <div class="p-3 border-b lg:border-r border-blue-100">
              <span
                class="block text-[10px] uppercase font-bold text-blue-500"
                >Servicio</span
              ><strong
                id="cron-info-nombre"
                class="text-slate-800"
              ></strong>
            </div>
            <div class="p-3 border-b border-blue-100">
              <span
                class="block text-[10px] uppercase font-bold text-blue-500"
                >Proveedor</span
              ><strong
                id="cron-info-proveedor"
                class="text-slate-800"
              ></strong>
            </div>
            <div class="p-3 sm:border-r border-blue-100">
              <span
                class="block text-[10px] uppercase font-bold text-blue-500"
                >Procedimiento</span
              ><strong
                id="cron-info-procedimiento"
                class="font-mono text-slate-800"
              ></strong>
            </div>
            <div class="p-3 lg:border-r border-blue-100">
              <span
                class="block text-[10px] uppercase font-bold text-blue-500"
                >Certificación</span
              ><strong
                id="cron-info-certificacion"
                class="font-mono text-slate-800"
              ></strong>
            </div>
            <div class="p-3">
              <span
                class="block text-[10px] uppercase font-bold text-blue-500"
                >Vigencia</span
              ><strong
                id="cron-info-vigencia"
                class="text-slate-800"
              ></strong>
            </div>
          </div>
        </div>
      </div>
      <div>
        <div class="section-header-badge emerald">
          <i data-lucide="stethoscope" class="w-4 h-4 text-emerald-600"></i>
          <div>
            <p class="text-xs font-bold text-slate-800">
              2. Equipos incluidos
            </p>
            <p class="text-[10px] text-slate-500">
              Se cargan automáticamente según los activos vinculados al
              contrato seleccionado.
            </p>
          </div>
        </div>
        <div
          id="cron-equipo-checkboxes"
          class="mt-3 grid grid-cols-1 md:grid-cols-2 gap-2 max-h-56 overflow-y-auto border border-slate-200 rounded-xl p-3 bg-slate-50"
        >
          <div class="col-span-2 p-4 text-center text-xs text-slate-400">
            Seleccione un contrato para consultar sus equipos.
          </div>
        </div>
        <p id="cron-equipos-count" class="text-[11px] text-slate-500 mt-2">
          0 equipos vinculados
        </p>
      </div>
      <div>
        <div class="section-header-badge">
          <i data-lucide="calendar-range" class="w-4 h-4 text-blue-600"></i>
          <div>
            <p class="text-xs font-bold text-slate-800">
              3. Programación de visitas
            </p>
            <p class="text-[10px] text-slate-500">
              Defina la frecuencia y los meses. La fecha de cada visita se
              asigna desde su icono mensual.
            </p>
          </div>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mt-4">
          <div>
            <label class="block text-xs font-semibold text-slate-600 mb-1"
              >Frecuencia*</label
            ><select
              id="cron-frecuencia"
              required
              onchange="applyCronFrequency()"
              class="w-full px-3 py-2 border border-slate-200 rounded-lg text-sm bg-white"
            >
              <option value="Mensual">Mensual</option>
              <option value="Cada 2 meses">Cada 2 meses</option>
              <option value="Cada 3 meses">Cada 3 meses</option>
              <option value="Cada 4 meses">Cada 4 meses</option>
              <option value="Cada 6 meses">Cada 6 meses</option>
              <option value="Anual">Anual</option>
              <option value="Personalizada">Personalizada</option>
            </select>
          </div>
          <div>
            <label class="block text-xs font-semibold text-slate-600 mb-1"
              >Año*</label
            ><input
              id="cron-year"
              type="number"
              min="2020"
              max="2100"
              required
              class="w-full px-3 py-2 border border-slate-200 rounded-lg text-sm"
            />
          </div>
        </div>
        <div class="mt-4">
          <label class="block text-xs font-bold text-slate-700 mb-2"
            >Meses que requieren visita*</label
          >
          <div
            id="cron-month-checkboxes"
            class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-6 gap-2"
          ></div>
          <p class="text-[10px] text-slate-400 mt-2">
            Después de guardar el plan, presione el icono de cada mes para
            asignar su fecha programada.
          </p>
        </div>
      </div>
      <div class="pt-4 border-t border-slate-100 flex justify-end gap-3">
        <button
          type="button"
          onclick="closeCronogramaModal()"
          class="px-4 py-2 text-slate-600 hover:bg-slate-100 rounded-lg text-sm font-medium"
        >
          Cancelar</button
        ><button
          type="submit"
          class="px-5 py-2 bg-blue-600 hover:bg-blue-700 text-white rounded-lg text-sm font-medium shadow-sm"
        >
          Guardar plan preventivo
        </button>
      </div>
    </form>
  </div>
</div>
