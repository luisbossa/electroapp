<!-- MODAL: FICHA TÉCNICA DE EQUIPO -->
<div
  id="modal-equipo"
  class="fixed inset-0 bg-slate-900/60 backdrop-blur-sm flex items-center justify-center hidden z-50 p-2 sm:p-4 overflow-hidden"
>
  <div
    class="bg-white rounded-2xl shadow-2xl w-full max-w-[96vw] h-[94vh] flex flex-col border border-slate-200 overflow-hidden my-auto"
  >
    <div
      class="px-6 py-4 border-b border-slate-100 flex items-center justify-between bg-gradient-to-r from-slate-900 via-slate-800 to-blue-900 text-white shrink-0 shadow-sm"
    >
      <div class="flex items-center gap-3">
        <div
          class="p-2.5 bg-blue-600 rounded-xl text-white shadow-lg ring-2 ring-blue-400/40"
        >
          <i data-lucide="stethoscope" class="w-6 h-6"></i>
        </div>
        <div>
          <div class="flex items-center gap-2">
            <h3
              id="modal-equipo-title"
              class="font-extrabold text-lg sm:text-xl tracking-tight text-white"
            >
              Ficha Técnica de Equipo Médico
            </h3>
            <span
              class="px-2 py-0.5 rounded-full text-[10px] font-bold bg-blue-500/30 text-blue-200 border border-blue-400/30 uppercase"
              >Activo Institucional</span
            >
          </div>
          <p class="text-xs text-blue-200 mt-0.5">
            Hoja de Vida, Ubicación, LOEM y Repuestos Vinculados
          </p>
        </div>
      </div>
      <button
        onclick="closeModal('modal-equipo')"
        class="p-1.5 text-slate-300 hover:text-white rounded-lg hover:bg-white/10 transition"
      >
        <i data-lucide="x" class="w-6 h-6"></i>
      </button>
    </div>

    <form
      onsubmit="saveEquipo(event)"
      class="p-6 space-y-6 overflow-y-auto flex-1 bg-slate-50/40"
    >
      <input type="hidden" id="eq-id" />
      <!-- SECCIÓN 1 -->
      <div
        class="bg-white p-5 rounded-2xl border border-slate-200 shadow-sm space-y-4"
      >
        <div class="section-header-badge">
          <div class="p-1.5 bg-blue-600 text-white rounded-lg shadow-sm">
            <i data-lucide="camera" class="w-4 h-4"></i>
          </div>
          <div>
            <h4
              class="text-xs sm:text-sm font-extrabold text-slate-900 uppercase tracking-wider"
            >
              Información general
            </h4>
            <p class="text-[11px] text-slate-500 font-medium">
              Identificación, fotografía y codificación institucional del
              equipo
            </p>
          </div>
        </div>
        <div class="grid grid-cols-1 lg:grid-cols-4 gap-5 items-start">
          <div class="lg:col-span-1">
            <label class="block text-xs font-bold text-slate-700 mb-1.5"
              >Fotografía del Equipo</label
            >
            <div
              id="imgPreview"
              class="w-full sm:w-72 h-44 border-2 border-dashed border-slate-300 rounded-xl flex flex-col items-center justify-center text-slate-400 text-xs p-2 bg-slate-50 bg-contain bg-no-repeat bg-origin-content bg-center shadow-inner"
            >
              <i
                data-lucide="image"
                class="w-8 h-8 text-slate-300 mb-1"
              ></i>
              <span>Vista Previa</span>
            </div>
            <input
              type="file"
              id="eq-img"
              accept="image/*"
              class="mt-2 text-xs w-full sm:w-72 text-slate-500 file:mr-2 file:py-1.5 file:px-3 file:rounded-lg file:border-0 file:text-xs file:font-semibold file:bg-blue-50 file:text-blue-700 hover:file:bg-blue-100 cursor-pointer"
              onchange="previewFile('eq-img', 'imgPreview', setEqImg)"
            />
          </div>
          <div
            class="lg:col-span-3 grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-3 gap-4"
          >
            <div>
              <label class="block text-xs font-bold text-slate-700 mb-1"
                >Número de Activo*</label
              ><input
                type="text"
                id="eq-activo"
                required
                class="w-full px-3 py-2 border border-slate-200 rounded-xl text-sm font-bold text-blue-600 bg-blue-50/30 focus:bg-white focus:ring-2 focus:ring-blue-500"
              />
            </div>
            <div>
              <label class="block text-xs font-bold text-slate-700 mb-1"
                >Descripción del Equipo Médico*</label
              ><input
                type="text"
                id="eq-nombre"
                oninput="updateAutoLinkedParts()"
                required
                class="w-full px-3 py-2 border border-slate-200 rounded-xl text-sm font-semibold focus:ring-2 focus:ring-blue-500"
              />
            </div>
            <div>
              <label class="block text-xs font-semibold text-slate-600 mb-1"
                >Marca</label
              ><input
                type="text"
                id="eq-marca"
                oninput="updateAutoLinkedParts()"
                class="w-full px-3 py-2 border border-slate-200 rounded-xl text-sm"
              />
            </div>
            <div>
              <label class="block text-xs font-semibold text-slate-600 mb-1"
                >Modelo</label
              ><input
                type="text"
                id="eq-modelo"
                oninput="updateAutoLinkedParts()"
                class="w-full px-3 py-2 border border-slate-200 rounded-xl text-sm"
              />
            </div>
            <div>
              <label class="block text-xs font-bold text-slate-700 mb-1"
                >Número de Serie*</label
              ><input
                type="text"
                id="eq-serie"
                required
                class="w-full px-3 py-2 border border-slate-200 rounded-xl text-sm focus:ring-2 focus:ring-blue-500"
              />
            </div>
            <div>
              <label class="block text-xs font-bold text-slate-700 mb-1"
                >Estado Operacional*</label
              ><select
                id="eq-estado"
                class="w-full px-3 py-2 border border-slate-200 rounded-xl text-sm font-semibold focus:ring-2 focus:ring-blue-500"
              >
                <option value="Operativo">Operativo</option>
                <option value="En Mantenimiento">En Mantenimiento</option>
                <option value="Fuera de Servicio">Fuera de Servicio</option>
                <option value="Dado de Baja">Dado de Baja</option>
              </select>
            </div>
            <div>
              <label class="block text-xs font-bold text-slate-700 mb-1"
                >Clasificación de Riesgo</label
              ><select
                id="eq-clasificacion"
                class="w-full px-3 py-2 border border-slate-200 rounded-xl text-sm focus:ring-2 focus:ring-blue-500"
              >
                <option value="Clase I">Clase I (Bajo Riesgo)</option>
                <option value="Clase II">Clase II (Riesgo Moderado)</option>
                <option value="Clase III">Clase III (Alto Riesgo)</option>
              </select>
            </div>
            <div>
              <label class="block text-xs font-semibold text-slate-600 mb-1"
                >Código SAP</label
              ><input
                type="text"
                id="eq-sap"
                class="w-full px-3 py-2 border border-slate-200 rounded-xl text-sm font-mono"
              />
            </div>
            <div>
              <label class="block text-xs font-semibold text-slate-600 mb-1"
                >Código SICOP</label
              ><input
                type="text"
                id="eq-sicop"
                class="w-full px-3 py-2 border border-slate-200 rounded-xl text-sm font-mono"
              />
            </div>
          </div>
        </div>
      </div>

      <!-- SECCIÓN 2 -->
      <div
        class="bg-white p-5 rounded-2xl border border-slate-200 shadow-sm space-y-4"
      >
        <div class="section-header-badge">
          <div class="p-1.5 bg-blue-600 text-white rounded-lg shadow-sm">
            <i data-lucide="map-pin" class="w-4 h-4"></i>
          </div>
          <div>
            <h4
              class="text-xs sm:text-sm font-extrabold text-white uppercase tracking-wider"
            >
              Ubicación
            </h4>
            <p class="text-[11px] font-medium">
              Sede, servicio físico y unidad responsable
            </p>
          </div>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-4 items-start">
          <div>
            <label class="block text-xs font-semibold text-slate-600 mb-1"
              >Ubicación (Sede / EBAIS)*</label
            >
            <select
              id="eq-ubicacion"
              required
              class="w-full px-3 py-2 border border-slate-200 rounded-xl text-sm"
            ></select>
          </div>
          <div>
            <label class="block text-xs font-semibold text-slate-600 mb-1"
              >Sububicación / Servicio</label
            ><input
              type="text"
              id="eq-sububicacion"
              class="w-full px-3 py-2 border border-slate-200 rounded-xl text-sm"
            />
          </div>
          <div>
            <label class="block text-xs font-semibold text-slate-600 mb-1"
              >Servicio Responsable</label
            ><input
              id="eq-servicio"
              type="text"
              class="w-full px-3 py-2 border border-slate-200 rounded-xl text-sm"
            />
          </div>
        </div>
      </div>

      <!-- SECCIÓN 3 -->
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
        <div
          class="bg-white p-5 rounded-2xl border border-slate-200 shadow-sm space-y-4"
        >
          <div class="section-header-badge">
            <div class="p-1.5 bg-blue-600 text-white rounded-lg shadow-sm">
              <i data-lucide="clock" class="w-4 h-4"></i>
            </div>
            <div>
              <h4
                class="text-xs sm:text-sm font-extrabold text-slate-900 uppercase"
              >
                Ciclo de Vida (LOEM)
              </h4>
            </div>
          </div>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div>
              <label class="block text-xs font-semibold text-slate-600 mb-1"
                >Fecha Ingreso</label
              >
              <input
                type="date"
                id="eq-fechaIngreso"
                onchange="calculateLifecycle()"
                class="w-full px-3 py-2 border border-slate-200 rounded-xl text-sm"
              />
            </div>
            <div>
              <label class="block text-xs font-semibold text-slate-600 mb-1"
                >LOEM (Años)</label
              >
              <input
                type="number"
                id="eq-loem"
                min="1"
                value="10"
                onchange="calculateLifecycle()"
                class="w-full px-3 py-2 border border-slate-200 rounded-xl text-sm font-bold"
              />
            </div>
          </div>
          <div
            class="bg-slate-50 p-3.5 rounded-xl border border-slate-200 space-y-1.5"
          >
            <div
              class="flex justify-between items-center text-xs font-bold"
            >
              <span class="text-slate-600">Consumo de Vida Útil:</span>
              <span id="lifecycleText" class="text-slate-500"
                >0% consumido</span
              >
            </div>
            <div class="progress-bar-bg">
              <div
                id="progressBar"
                class="progress-bar-fill"
                style="width: 0%"
              ></div>
            </div>
            <div
              id="lifecycleAlert"
              class="hidden text-xs bg-red-50 border border-red-200 text-red-700 p-2.5 rounded-xl font-bold flex items-center gap-2 mt-2"
            >
              <i data-lucide="triangle-alert" class="w-4 h-4 shrink-0"></i>
              <span
                >Requerido evaluar reemplazo por ciclo de vida útil.</span
              >
            </div>
          </div>
        </div>

        <div
          class="bg-white p-5 rounded-2xl border border-slate-200 shadow-sm space-y-4"
        >
          <div class="section-header-badge">
            <div class="p-1.5 bg-blue-600 text-white rounded-lg shadow-sm">
              <i data-lucide="shield-check" class="w-4 h-4"></i>
            </div>
            <div>
              <h4
                class="text-xs sm:text-sm font-extrabold text-slate-900 uppercase"
              >
                Cobertura y Garantía
              </h4>
            </div>
          </div>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div>
              <label class="block text-xs font-bold text-slate-700 mb-1"
                >Condición*</label
              >
              <select
                id="eq-condicGarantia"
                onchange="toggleTipoGarantiaField()"
                class="w-full px-3 py-2 border border-slate-200 rounded-xl text-sm font-semibold"
              >
                <option value="Ninguno">Ninguno</option>
                <option value="Bajo Garantía">Bajo Garantía</option>
                <option value="Bajo Contrato">Bajo Contrato</option>
              </select>
            </div>
            <div
              id="wrapper-tipo-garantia"
              class="hidden bg-amber-50/80 p-2 rounded-xl border border-amber-200"
            >
              <label class="block text-[11px] font-bold text-amber-900 mb-1"
                >Entidad Responsable*</label
              >
              <select
                id="eq-tipoGarantia"
                class="w-full px-2 py-1 border border-amber-300 rounded-lg text-xs font-bold"
              >
                <option value="Direccion Regional">
                  Dirección Regional
                </option>
                <option value="DAI">DAI</option>
                <option value="DEI">DEI</option>
                <option value="ASN">ASN</option>
                <option value="OTRO">OTRO</option>
              </select>
            </div>
            <div>
              <label class="block text-xs font-semibold text-slate-600 mb-1"
                >Nº Contrato / Proc. (Vincular)</label
              >
              <select
                id="eq-numProcedimiento"
                class="w-full px-3 py-2 border border-slate-200 rounded-xl text-sm bg-white font-medium"
              ></select>
            </div>
          </div>
        </div>
      </div>

      <!-- SECCIÓN 4 -->
      <div
        class="bg-white p-6 rounded-2xl border border-slate-200 shadow-sm space-y-4"
      >
        <div
          class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 border-b border-slate-100 pb-3"
        >
          <div class="section-header-badge emerald flex-1">
            <div
              class="p-1.5 bg-emerald-600 text-white rounded-lg shadow-sm"
            >
              <i data-lucide="package-check" class="w-4 h-4"></i>
            </div>
            <div>
              <div class="flex items-center gap-2">
                <h4
                  class="text-xs sm:text-sm font-extrabold text-slate-900 uppercase"
                >
                  Repuestos e Insumos Compatibles
                </h4>
                <span
                  id="linked-parts-count-badge"
                  class="text-[11px] px-2.5 py-0.5 rounded-full bg-emerald-100 text-emerald-800 font-bold"
                  >0 asociados</span
                >
              </div>
            </div>
          </div>
        </div>
        <div
          id="auto-linked-parts-container"
          class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-4 pt-1"
        ></div>
      </div>

      <!-- Campos heredados conservados únicamente para compatibilidad con registros anteriores. -->
      <input type="hidden" id="eq-frecuenciaMaint" value="Semestral" />
      <input type="hidden" id="eq-nextMaint" />
      <input type="hidden" id="eq-observaciones" />

      <!-- BOTONES FLOTANTES -->
      <div
        class="pt-4 flex justify-end gap-3 border-t border-slate-200 sticky bottom-0 bg-slate-50/95 backdrop-blur-md py-3 -mx-6 px-6 shrink-0"
      >
        <button
          type="button"
          onclick="closeModal('modal-equipo')"
          class="px-5 py-2.5 border border-slate-300 rounded-xl text-sm font-semibold text-slate-600 hover:bg-slate-200 transition"
        >
          Cancelar
        </button>
        <button
          type="submit"
          class="px-6 py-2.5 bg-blue-600 text-white rounded-xl text-sm font-bold hover:bg-blue-700 shadow-md transition flex items-center gap-2"
        >
          <i data-lucide="save" class="w-4 h-4"></i> Guardar Ficha Técnica
        </button>
      </div>
    </form>
  </div>
</div>
