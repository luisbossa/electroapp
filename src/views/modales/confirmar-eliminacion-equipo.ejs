<!-- MODAL INTERNO: CONFIRMAR ELIMINACIÓN DE EQUIPO -->
<div
  id="modal-eliminar-equipo"
  class="fixed inset-0 bg-slate-900/60 backdrop-blur-sm flex items-center justify-center hidden z-50 p-2 sm:p-4 overflow-hidden"
>
  <div
    class="w-full max-w-md bg-white rounded-2xl shadow-2xl overflow-hidden flex flex-col"
  >
    <div
      class="px-5 py-4 border-b border-slate-200 flex items-center justify-between"
    >
      <div class="flex items-center gap-3">
        <div
          class="w-10 h-10 rounded-xl bg-red-500/15 border border-red-300/20 flex items-center justify-center"
        >
          <i data-lucide="trash-2" class="w-5 h-5 text-red-200"></i>
        </div>
        <div>
          <h3 class="text-lg font-extrabold">Eliminar equipo</h3>
          <p class="text-xs opacity-80 mt-0.5">
            Confirmación de eliminación
          </p>
        </div>
      </div>
      <button
        type="button"
        onclick="closeDeleteEquipoModal()"
        class="p-2 rounded-lg hover:bg-white/10"
      >
        <i data-lucide="x" class="w-5 h-5"></i>
      </button>
    </div>

    <div class="p-5 bg-white">
      <p class="text-sm text-slate-700 leading-6">
        ¿Está seguro que desea eliminar este equipo del inventario?
      </p>
      <div
        class="mt-4 p-3.5 rounded-xl border border-red-200 bg-red-50 flex items-start gap-3"
      >
        <i
          data-lucide="triangle-alert"
          class="w-5 h-5 text-red-600 shrink-0 mt-0.5"
        ></i>
        <div>
          <p class="text-sm font-bold text-red-700">
            Esta acción no se puede deshacer.
          </p>
          <p class="text-xs text-red-600 mt-1">
            El equipo se eliminará permanentemente del inventario.
          </p>
        </div>
      </div>
    </div>

    <div
      class="px-5 py-4 border-t border-slate-200 bg-slate-50 flex flex-col-reverse sm:flex-row sm:justify-end gap-2"
    >
      <button
        type="button"
        onclick="closeDeleteEquipoModal()"
        class="px-4 py-2.5 rounded-lg border border-slate-300 bg-white hover:bg-slate-100 text-slate-700 text-sm font-bold"
      >
        Cancelar
      </button>
      <button
        type="button"
        onclick="confirmDeleteEquipo()"
        class="px-4 py-2.5 rounded-lg bg-red-600 hover:bg-red-700 text-white text-sm font-bold flex items-center justify-center gap-2"
      >
        <i data-lucide="trash-2" class="w-4 h-4"></i> Eliminar equipo
      </button>
    </div>
  </div>
</div>
