<!-- MODAL: DEVOLUCIÓN DE EQUIPO -->
<div
  id="modal-devolucion-equipo"
  class="fixed inset-0 bg-slate-900/50 backdrop-blur-sm flex items-center justify-center hidden z-50 p-4"
>
  <div
    class="bg-white rounded-xl shadow-2xl w-full max-w-lg border border-slate-200 overflow-hidden my-auto"
  >
    <div
      class="px-6 py-4 border-b border-slate-100 flex items-center justify-between bg-emerald-50"
    >
      <h3 class="font-bold text-emerald-900 text-lg">
        Registrar Devolución de Equipo
      </h3>
      <button
        onclick="closeModal('modal-devolucion-equipo')"
        class="text-slate-400 hover:text-slate-600"
      >
        <i data-lucide="x" class="w-5 h-5"></i>
      </button>
    </div>
    <form onsubmit="saveDevolucionEquipo(event)" class="p-6 space-y-4">
      <input type="hidden" id="dev-seq-id" />
      <div>
        <label class="block text-xs font-semibold text-slate-600 mb-1"
          >Fecha y Hora Real*</label
        ><input
          type="datetime-local"
          id="dev-fecha-real"
          required
          class="w-full px-3 py-2 border border-slate-200 rounded-lg text-sm"
        />
      </div>
      <div>
        <label class="block text-xs font-semibold text-slate-600 mb-1"
          >Persona que recibe*</label
        ><input
          type="text"
          id="dev-recibe"
          required
          class="w-full px-3 py-2 border border-slate-200 rounded-lg text-sm"
        />
      </div>
      <div>
        <label class="block text-xs font-semibold text-slate-600 mb-1"
          >Estado al Regresar*</label
        >
        <select
          id="dev-estado-equipo"
          class="w-full px-3 py-2 border border-slate-200 rounded-lg text-sm"
        >
          <option value="Operativo">
            Operativo (Funcionando correctamente)
          </option>
          <option value="En Mantenimiento">En Mantenimiento</option>
          <option value="Fuera de Servicio">Fuera de Servicio</option>
        </select>
      </div>
      <div>
        <label class="block text-xs font-semibold text-slate-600 mb-1"
          >Comentarios Finales</label
        ><textarea
          id="dev-comentarios"
          rows="2"
          class="w-full px-3 py-2 border border-slate-200 rounded-lg text-sm"
        ></textarea>
      </div>
      <div class="pt-4 flex justify-end gap-3 border-t border-slate-100">
        <button
          type="button"
          onclick="closeModal('modal-devolucion-equipo')"
          class="px-4 py-2 text-slate-600 hover:bg-slate-100 rounded-lg text-sm"
        >
          Cancelar
        </button>
        <button
          type="submit"
          class="px-5 py-2 bg-emerald-600 hover:bg-emerald-700 text-white rounded-lg text-sm font-medium shadow-sm"
        >
          Confirmar Devolución
        </button>
      </div>
    </form>
  </div>
</div>
