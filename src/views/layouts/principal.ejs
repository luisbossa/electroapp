<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="theme-color" content="#2563eb" />
    <title><%= titulo %></title>

    <!-- Librerías servidas desde el propio sitio (se generan con `npm run build`; versiones fijas en package.json) -->
    <script src="/vendor/lucide.min.js?v=<%= version %>"></script>
    <script src="/vendor/chart.umd.min.js?v=<%= version %>"></script>
    <script src="/vendor/sweetalert2.all.min.js?v=<%= version %>"></script>
    <script src="/js/iconos.js"></script>

    <link rel="preload" as="image" href="/assets/fondo-login.png" fetchpriority="high" />
    <link rel="stylesheet" href="/css/base.css?v=<%= version %>" />
    <link rel="stylesheet" href="/css/confirmaciones.css?v=<%= version %>" />
    <link rel="stylesheet" href="/css/ventanas.css?v=<%= version %>" />
    <link rel="stylesheet" href="/css/capas.css?v=<%= version %>" />
    <link rel="stylesheet" href="/css/fichas.css?v=<%= version %>" />
    <link rel="stylesheet" href="/css/login.css?v=<%= version %>" />
    <!-- Tailwind compilado: va al final para conservar la prioridad que tenía el CDN -->
    <link rel="stylesheet" href="/css/tailwind.css?v=<%= version %>" />
    <link rel="shortcut icon" href="favicon.ico" type="image/x-icon">
  </head>
  <body class="bg-brand-bg font-sans text-slate-800 flex h-screen overflow-hidden">
<%- body %>

<%- include('../partials/scripts') %>
  </body>
</html>
