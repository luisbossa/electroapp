<!-- MENÚ LATERAL (estilos en public/css/menu-lateral.css) -->
<aside class="menu-lateral no-imprimir" aria-label="Menú principal">
  <div class="menu-marca">
    <div class="menu-marca-logo">
      <i data-lucide="activity"></i>
    </div>
    <div class="menu-marca-texto">
      <h1>Gestión de Equipo Médico</h1>
      <p>Ingeniería y Mantenimiento · EQM · ASN</p>
    </div>
  </div>

  <nav class="menu-nav">
    <div class="menu-grupo">
      <p class="menu-grupo-titulo">Inventario</p>
      <button
        id="nav-equipos"
        onclick="changeTab('equipos', this)"
        class="nav-btn active"
        title="Listado de equipos"
      >
        <span class="nav-icono"><i data-lucide="stethoscope"></i></span>
        <span class="nav-texto">Listado de equipos</span>
        <span id="menu-count-equipos" class="nav-contador">0</span>
      </button>
      <button
        onclick="changeTab('bodega', this)"
        class="nav-btn"
        title="Inventario de bodega"
      >
        <span class="nav-icono"><i data-lucide="package"></i></span>
        <span class="nav-texto">Inventario de bodega</span>
        <span id="menu-count-bodega" class="nav-contador">0</span>
      </button>
    </div>

    <div class="menu-grupo">
      <p class="menu-grupo-titulo">Operación</p>
      <button
        id="nav-averias"
        onclick="changeTab('reporte-averias', this)"
        class="nav-btn"
        title="Reporte de averías"
      >
        <span class="nav-icono"><i data-lucide="octagon-alert"></i></span>
        <span class="nav-texto">Reporte de averías</span>
        <span id="menu-count-averias" class="nav-contador nav-contador--alerta">0</span>
      </button>
      <button
        onclick="changeTab('salida-equipos', this)"
        class="nav-btn"
        title="Salida de equipos"
      >
        <span class="nav-icono"><i data-lucide="truck"></i></span>
        <span class="nav-texto">Salida de equipos</span>
        <span id="menu-count-salida-equipos" class="nav-contador nav-contador--info">0</span>
      </button>
      <button
        onclick="changeTab('Cronogramas Mantenimiento Preventivo', this)"
        class="nav-btn"
        title="Cronogramas de mantenimiento preventivo"
      >
        <span class="nav-icono"><i data-lucide="calendar"></i></span>
        <span class="nav-texto">Mantenimiento preventivo</span>
      </button>
    </div>

    <div class="menu-grupo">
      <p class="menu-grupo-titulo">Administración</p>
      <button
        onclick="changeTab('procedimientos-contratos', this)"
        class="nav-btn"
        title="Procedimientos y contratos"
      >
        <span class="nav-icono"><i data-lucide="file-badge"></i></span>
        <span class="nav-texto">Procedimientos y contratos</span>
        <span id="menu-count-procedimientos" class="nav-contador">0</span>
      </button>
      <button
        onclick="changeTab('proveedores', this)"
        class="nav-btn"
        title="Proveedores"
      >
        <span class="nav-icono"><i data-lucide="building-2"></i></span>
        <span class="nav-texto">Proveedores</span>
      </button>
    </div>
  </nav>

  <div class="menu-pie">
    <button
      id="nav-usuarios"
      onclick="changeTab('usuarios', this)"
      class="nav-btn hidden"
      title="Administración de usuarios"
    >
      <span class="nav-icono"><i data-lucide="users"></i></span>
      <span class="nav-texto">Administración de usuarios</span>
    </button>
  </div>
</aside>
