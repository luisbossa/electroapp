<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= titulo %> · Gestión de Equipo Médico</title>
    <style>
      body { margin: 0; min-height: 100vh; display: grid; place-items: center; padding: 16px;
             font-family: system-ui, -apple-system, "Segoe UI", sans-serif; background: #e6f1fd; color: #0f172a; }
      .tarjeta { max-width: 420px; width: 100%; padding: 32px 28px; border-radius: 20px; background: #fff;
                 box-shadow: 0 20px 50px rgba(15, 55, 110, .15); text-align: center; }
      .codigo { font-size: 3rem; font-weight: 900; color: #2563eb; margin: 0; }
      p { color: #64748b; }
      a { display: inline-block; margin-top: 8px; padding: 12px 20px; border-radius: 12px; background: #2563eb;
          color: #fff; font-weight: 700; text-decoration: none; }
    </style>
  </head>
  <body>
    <main class="tarjeta">
      <p class="codigo"><%= codigo %></p>
      <h1><%= titulo %></h1>
      <p><%= mensaje %></p>
      <a href="/">Volver al sistema</a>
    </main>
  </body>
</html>
