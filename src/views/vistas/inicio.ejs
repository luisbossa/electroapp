<!-- VISTA 1: DASHBOARD GENERAL -->
<div
  id="view-inicio"
  class="tab-content hidden space-y-6"
  aria-hidden="true"
>
  <div class="flex items-center justify-between">
    <div>
      <h2 class="text-2xl font-bold text-slate-800">
        Panel de Control Operativo
      </h2>
      <p class="text-sm text-slate-500">
        Métricas clave de equipos, ciclo de vida, averías y bodega.
      </p>
    </div>
    <div class="flex gap-2">
      <button
        onclick="openAveriaModal()"
        class="bg-red-600 hover:bg-red-700 text-white px-3 py-2 rounded-lg text-sm font-medium flex items-center gap-2 shadow-sm transition"
      >
        <i data-lucide="octagon-alert" class="w-4 h-4"></i> Reportar
        Avería
      </button>
      <button
        onclick="openEquipoModal()"
        class="bg-blue-600 hover:bg-blue-700 text-white px-3 py-2 rounded-lg text-sm font-medium flex items-center gap-2 shadow-sm transition"
      >
        <i data-lucide="plus" class="w-4 h-4"></i> Nuevo Equipo
      </button>
    </div>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4">
    <div
      class="bg-white p-5 rounded-xl border border-slate-200 shadow-sm flex items-center justify-between"
    >
      <div>
        <p class="text-xs font-semibold text-slate-400 uppercase">
          Total Equipos
        </p>
        <h3
          id="kpi-total-equipos"
          class="text-2xl font-bold text-slate-800 mt-1"
        >
          0
        </h3>
        <span class="text-xs text-emerald-600 font-medium"
          >Activos registrados</span
        >
      </div>
      <div class="p-3 bg-blue-50 text-blue-600 rounded-lg">
        <i data-lucide="monitor" class="w-6 h-6"></i>
      </div>
    </div>

    <div
      class="bg-white p-5 rounded-xl border border-slate-200 shadow-sm flex items-center justify-between"
    >
      <div>
        <p class="text-xs font-semibold text-slate-400 uppercase">
          Averías Activas
        </p>
        <h3
          id="kpi-averias-activas"
          class="text-2xl font-bold text-red-600 mt-1"
        >
          0
        </h3>
        <span class="text-xs text-red-500 font-medium"
          >Reportes sin resolver</span
        >
      </div>
      <div class="p-3 bg-red-50 text-red-600 rounded-lg">
        <i data-lucide="octagon-alert" class="w-6 h-6"></i>
      </div>
    </div>

    <div
      class="bg-white p-5 rounded-xl border border-slate-200 shadow-sm flex items-center justify-between"
    >
      <div>
        <p class="text-xs font-semibold text-slate-400 uppercase">
          Alertas Stock
        </p>
        <h3
          id="kpi-stock-bajo"
          class="text-2xl font-bold text-slate-800 mt-1"
        >
          0
        </h3>
        <span class="text-xs text-amber-600 font-medium"
          >Stock crítico / bajo</span
        >
      </div>
      <div class="p-3 bg-amber-50 text-amber-600 rounded-lg">
        <i data-lucide="triangle-alert" class="w-6 h-6"></i>
      </div>
    </div>

    <div
      class="bg-white p-5 rounded-xl border border-slate-200 shadow-sm flex items-center justify-between"
    >
      <div>
        <p class="text-xs font-semibold text-slate-400 uppercase">
          Alertas Vida Útil
        </p>
        <h3
          id="kpi-vida-util"
          class="text-2xl font-bold text-slate-800 mt-1"
        >
          0
        </h3>
        <span class="text-xs text-purple-600 font-medium"
          >&gt;= 80% LOEM cumplido</span
        >
      </div>
      <div class="p-3 bg-purple-50 text-purple-600 rounded-lg">
        <i data-lucide="clock" class="w-6 h-6"></i>
      </div>
    </div>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
    <div
      class="lg:col-span-2 bg-white rounded-xl border border-slate-200 shadow-sm p-5"
    >
      <h3
        class="font-bold text-slate-800 mb-3 flex items-center justify-between"
      >
        <span>Últimas Averías / Mto Correctivo</span>
        <button
          onclick="
            changeTab('reporte-averias', document.getElementById('nav-averias'))
          "
          class="text-xs text-blue-600 hover:underline"
        >
          Ver todas
        </button>
      </h3>
      <div id="dash-averias-list" class="space-y-2"></div>
    </div>

    <div
      class="bg-white rounded-xl border border-slate-200 shadow-sm p-5"
    >
      <h3 class="font-bold text-slate-800 mb-3">Accesos Directos</h3>
      <div class="space-y-2">
        <button
          onclick="openAveriaModal()"
          class="w-full text-left p-2.5 bg-slate-50 hover:bg-slate-100 rounded-lg text-sm font-medium flex items-center gap-2"
        >
          <i
            data-lucide="octagon-alert"
            class="w-4 h-4 text-red-600"
          ></i>
          Reportar Falla / Avería
        </button>
        <button
          onclick="openSalidaEquipoModal()"
          class="w-full text-left p-2.5 bg-slate-50 hover:bg-slate-100 rounded-lg text-sm font-medium flex items-center gap-2"
        >
          <i data-lucide="truck" class="w-4 h-4 text-blue-600"></i>
          Registrar Salida de Equipo
        </button>
        <button
          onclick="openBodegaModal()"
          class="w-full text-left p-2.5 bg-slate-50 hover:bg-slate-100 rounded-lg text-sm font-medium flex items-center gap-2"
        >
          <i
            data-lucide="package-plus"
            class="w-4 h-4 text-emerald-600"
          ></i>
          Registrar Ficha de Repuesto
        </button>
        <button
          onclick="openSalidaModal()"
          class="w-full text-left p-2.5 bg-slate-50 hover:bg-slate-100 rounded-lg text-sm font-medium flex items-center gap-2"
        >
          <i
            data-lucide="arrow-right-left"
            class="w-4 h-4 text-amber-600"
          ></i>
          Registrar Salida de Repuesto
        </button>
      </div>
    </div>
  </div>
</div>
