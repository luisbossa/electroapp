<!-- VISTA: PROCEDIMIENTOS / CONTRATOS -->
<div
  id="view-procedimientos-contratos"
  class="tab-content hidden space-y-6"
>
  <div
    class="flex flex-col sm:flex-row sm:items-center justify-between gap-4"
  >
    <div>
      <h2 class="text-2xl font-bold text-slate-800">
        Procedimientos / Contratos
      </h2>
      <p class="text-sm text-slate-500"></p>
    </div>
    <button
      onclick="openProcedimientoModal()"
      class="bg-blue-600 hover:bg-blue-700 text-white px-4 py-2 rounded-lg text-sm font-medium flex items-center gap-2 shadow-sm transition shrink-0"
    >
      <i data-lucide="plus" class="w-4 h-4"></i> Nuevo Procedimiento
    </button>
  </div>

  <div class="module-search-shell">
    <i data-lucide="search" class="module-search-icon"></i
    ><input
      id="procedimientos-search"
      oninput="renderProcedimientosView()"
      autocomplete="off"
      placeholder="Buscar procedimiento, contrato o proveedor..."
      class="module-search-input"
    />
  </div>

  <div id="procedimientos-container" class="space-y-6"></div>
</div>
