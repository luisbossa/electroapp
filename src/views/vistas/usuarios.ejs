<!-- VISTA: ADMINISTRACIÓN DE USUARIOS -->
<div id="view-usuarios" class="tab-content hidden space-y-6">
  <div
    class="flex flex-col sm:flex-row sm:items-center justify-between gap-4"
  >
    <div>
      <h2 class="text-2xl font-bold text-slate-800">
        Administración de Usuarios
      </h2>
      <p class="text-sm text-slate-500">
        Crea y administra las cuentas que pueden ingresar al sistema.
      </p>
    </div>
    <button
      onclick="openUsuarioModal()"
      class="bg-blue-600 hover:bg-blue-700 text-white px-4 py-2 rounded-lg text-sm font-medium flex items-center gap-2 shadow-sm transition"
    >
      <i data-lucide="user-plus" class="w-4 h-4"></i> Nuevo Usuario
    </button>
  </div>
  <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
    <div
      class="bg-white p-5 rounded-xl border border-slate-200 shadow-sm"
    >
      <p class="text-xs font-semibold text-slate-400 uppercase">
        Total Usuarios
      </p>
      <h3 id="users-kpi-total" class="text-2xl font-bold mt-1">0</h3>
    </div>
    <div
      class="bg-white p-5 rounded-xl border border-slate-200 shadow-sm"
    >
      <p class="text-xs font-semibold text-slate-400 uppercase">
        Administradores
      </p>
      <h3
        id="users-kpi-admin"
        class="text-2xl font-bold text-blue-600 mt-1"
      >
        0
      </h3>
    </div>
    <div
      class="bg-white p-5 rounded-xl border border-slate-200 shadow-sm"
    >
      <p class="text-xs font-semibold text-slate-400 uppercase">
        Usuarios Activos
      </p>
      <h3
        id="users-kpi-active"
        class="text-2xl font-bold text-emerald-600 mt-1"
      >
        0
      </h3>
    </div>
  </div>
  <div
    class="bg-white rounded-xl border border-slate-200 shadow-sm overflow-hidden"
  >
    <div class="overflow-x-auto">
      <table class="w-full text-left text-sm">
        <thead
          class="bg-slate-50 text-slate-500 font-semibold border-b border-slate-200"
        >
          <tr>
            <th class="p-4">Nombre</th>
            <th class="p-4">Usuario</th>
            <th class="p-4">Rol</th>
            <th class="p-4">Estado</th>
            <th class="p-4 text-right">Acciones</th>
          </tr>
        </thead>
        <tbody
          id="table-usuarios"
          class="divide-y divide-slate-100"
        ></tbody>
      </table>
    </div>
  </div>
</div>
