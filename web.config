<?xml version="1.0" encoding="utf-8"?>
<!--
  Publicación en IIS con HttpPlatformHandler (módulo oficial de Microsoft).
  IIS inicia "node server.js", le asigna un puerto interno y le reenvía todas las peticiones.
  Requisitos y pasos: ver docs/DESPLIEGUE-IIS.md
-->
<configuration>
  <system.webServer>
    <handlers>
      <add name="httpPlatformHandler" path="*" verb="*" modules="httpPlatformHandler" resourceType="Unspecified" requireAccess="Script" />
    </handlers>

    <!--
      processesPerApplication = 1: SQLite y los respaldos programados requieren un solo proceso.
      stdoutLogFile: consola del servidor (arranque, errores, respaldos). La carpeta "logs" debe existir.
      Si Node está instalado en otra ruta, ajuste processPath.
    -->
    <httpPlatform processPath="C:\Program Files\nodejs\node.exe"
                  arguments=".\server.js"
                  processesPerApplication="1"
                  startupTimeLimit="60"
                  startupRetryCount="3"
                  requestTimeout="00:05:00"
                  stdoutLogEnabled="true"
                  stdoutLogFile=".\logs\node">
      <environmentVariables>
        <!-- Puerto interno que asigna IIS; no cambiar -->
        <environmentVariable name="PORT" value="%HTTP_PLATFORM_PORT%" />
        <environmentVariable name="HOST" value="127.0.0.1" />
        <environmentVariable name="NODE_ENV" value="production" />

        <!-- IIS actúa como proxy: así Node ve la IP real de cada usuario -->
        <environmentVariable name="TRUST_PROXY" value="true" />
        <!-- false si el sitio se usa por http://. Cambiar a true solo con HTTPS configurado en IIS -->
        <environmentVariable name="COOKIE_SECURE" value="false" />

        <!-- Respaldos automáticos de SQLite -->
        <environmentVariable name="BACKUP_INTERVAL_HOURS" value="24" />
        <environmentVariable name="BACKUP_KEEP" value="30" />
        <!-- Recomendado: carpeta en otro disco o en red, p. ej. D:\Respaldos\GestionEquipoMedico -->
        <environmentVariable name="BACKUP_DIR" value="data\respaldos" />

        <!-- Defina SESSION_SECRET y ADMIN_PASSWORD en el archivo .env del servidor, no aquí -->
      </environmentVariables>
    </httpPlatform>

    <security>
      <requestFiltering>
        <!-- 30 MB: permite fotos en las fichas (el servidor acepta hasta 25 MB de JSON) -->
        <requestLimits maxAllowedContentLength="31457280" />
        <hiddenSegments>
          <add segment="node_modules" />
          <add segment="data" />
          <add segment="logs" />
          <add segment="src" />
          <add segment="scripts" />
          <add segment=".env" />
        </hiddenSegments>
      </requestFiltering>
    </security>

    <!-- Deja pasar las páginas de error de la aplicación en lugar de las de IIS -->
    <httpErrors existingResponse="PassThrough" />
  </system.webServer>
</configuration>
