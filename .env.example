# Copie este archivo como .env y ajuste los valores.
PORT=3000
HOST=0.0.0.0
NODE_ENV=production

# Carpeta y archivo de la base de datos SQLite (relativos a la raíz del proyecto)
DATA_DIR=data
DB_FILE=gestion.db

# Administrador que se crea SOLO la primera vez (cuando no hay usuarios)
ADMIN_USER=admin
ADMIN_PASSWORD=cambie-esta-clave

# Secreto de las cookies de sesión. Si se omite, se genera y guarda en data/.session-secret
# SESSION_SECRET=
SESSION_HOURS=10

# true solo si está detrás de un proxy inverso (IIS/Nginx) con HTTPS
TRUST_PROXY=false
