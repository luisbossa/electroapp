# Copie este archivo como .env y ajuste los valores.
PORT=3000
HOST=0.0.0.0
NODE_ENV=production

# Carpeta y archivo de la base de datos SQLite (relativos a la raíz del proyecto)
DATA_DIR=data
DB_FILE=gestion.db

# Administrador que se crea SOLO la primera vez (cuando no hay usuarios)
ADMIN_USER=admin
ADMIN_PASSWORD=cambie-esta-clave

# Secreto de las cookies de sesión. Si se omite, se genera y guarda en data/.session-secret
# SESSION_SECRET=
SESSION_HOURS=10
# Minutos sin actividad tras los cuales se cierra la sesión (también si se cerró la pestaña)
SESSION_IDLE_MINUTES=30

# true solo si está detrás de un proxy inverso (IIS/Nginx) con HTTPS (en Vercel es automático)
TRUST_PROXY=false

# true muestra el aviso "Versión de demostración" en el ingreso (en Vercel es automático)
DEMO_MODE=false

# Cookie solo por HTTPS. Si se omite, sigue a TRUST_PROXY. En IIS con http:// interno: false
# COOKIE_SECURE=false

# Respaldos automáticos de la base SQLite
# Cada cuántas horas (0 = desactivado)
BACKUP_INTERVAL_HOURS=24
# Cuántos respaldos conservar (los más antiguos se borran)
BACKUP_KEEP=30
# Carpeta de respaldos (por defecto data/respaldos). Recomendado: otro disco o carpeta de red
# BACKUP_DIR=D:\Respaldos\GestionEquipoMedico
